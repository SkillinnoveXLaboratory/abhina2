{
  "name": "abhina-server",
  "version": "1.0.0",
  "description": "Express TypeScript server for ABHINA Charitable Trust website",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "seed": "ts-node src/db-seed.ts",
    "seed:content": "ts-node src/seed-content.ts",
    "test:notifications": "ts-node --transpile-only scripts/send-notifications.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/morgan": "^1.9.10",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.1.0",
    "mongoose": "^9.7.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
